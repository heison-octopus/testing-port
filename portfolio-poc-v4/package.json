{
  "name": "bhss-portfolio-v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node backend/index.js",
    "client": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "playwright test --config tests/playwright.config.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}